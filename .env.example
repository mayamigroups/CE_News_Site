# Required before exposing the admin panel online. Use a long, unique password.
ADMIN_PASSWORD=replace-this-with-a-long-unique-password
# Generate a long random secret, for example with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-this-with-a-long-random-secret
PORT=3000
SITE_URL=http://localhost:3000

# Optional: Configurable AI-Assisted Newsroom (Server-side only — never exposed to browser clients)
# If AI_API_KEY is left blank, source collection, manual drafting, and the deterministic 6-role newsroom workflow still work 100% locally at $0.00 API cost.
AI_PROVIDER=local-deterministic
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
AI_BASE_URL=
AI_TIMEOUT_MS=12000

# Optional: Configurable Analytics & Search Performance Monitoring
# If left blank, MachineWire uses its built-in privacy-safe internal telemetry engine.
GA_MEASUREMENT_ID=
PLAUSIBLE_DOMAIN=
GSC_VERIFICATION_CODE=
GSC_PROPERTY_URL=

# Optional: Newsletter Email Delivery Provider & Social Media Distribution Integrations
# Server-side only — never exposed to browser clients.
# If EMAIL_PROVIDER / EMAIL_API_KEY are left blank, the public signup UI clearly marks the email provider as not yet connected while storing subscriber consent & preferences locally.
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_WEBHOOK_URL=
EMAIL_FROM=briefing@machinewire.example

# Social Media Distribution (API calls execute ONLY after required accounts & permissions are configured)
SOCIAL_LINKEDIN_ACCESS_TOKEN=
SOCIAL_LINKEDIN_ORG_URN=
SOCIAL_X_BEARER_TOKEN=
SOCIAL_WEBHOOK_URL=
